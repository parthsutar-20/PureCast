# ── Application ───────────────────────────────────────────
APP_NAME=purecast
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://purecast:purecast_dev@localhost:5432/purecast
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# ── MQTT ─────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=purecast_ingestor
MQTT_PASSWORD=change-me-in-production
MQTT_TOPIC_PREFIX=purecast

# ── Auth / JWT ───────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Observability ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=purecast-api
PROMETHEUS_PORT=9090

# ── ML ───────────────────────────────────────────────────
MODEL_REGISTRY_PATH=./models
ML_MIN_TRAINING_SAMPLES=500
ML_RETRAIN_INTERVAL_HOURS=24

# ── Notifications ────────────────────────────────────────
NOTIFICATION_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Commerce ─────────────────────────────────────────────
COMMERCE_PROVIDER=fake
STRIPE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
